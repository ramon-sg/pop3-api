{
  "name": "pop3-api",
  "module": "index.ts",
  "type": "module",
  "version": "0.0.3-rc.1",
  "scripts": {
    "clear": "rm -rf dist",
    "build": "bun run clear && bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "LOG_LEVEL=off bun test ./test",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "log4js": "^6.9.1",
    "node-pop3": "0.15.3",
    "postal-mime": "^2.2.8"
  },
  "patchedDependencies": {
    "node-pop3@0.15.3": "patches/node-pop3@0.15.3.patch"
  }
}
